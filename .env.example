# Call page (/call) — copy to .env.local for local use; set the same names in Vercel for Production + Preview.
# Never commit real values.

# base64 of the service account key JSON (macOS: base64 -i key.json | pbcopy)
GOOGLE_SERVICE_ACCOUNT_JSON_B64=PASTE_BASE64_KEY_JSON_HERE
# Comma-separated calendar IDs that count as busy (usually your Gmail address)
CALENDAR_IDS=you@gmail.com
# IANA zone used to define "today" and call hours
OWNER_TZ=Europe/London
CALL_HOURS_START=09:00
CALL_HOURS_END=22:00
# Ignore gaps shorter than this
MIN_SLOT_MINUTES=20
# Round slot starts up to this step
ROUND_TO_MINUTES=15
# Today plus 2 more days in the friends view
DAYS_AHEAD=3
# Long random string that unlocks the friends view (openssl rand -base64 24 | tr -d '/+=')
FRIENDS_KEY=REPLACE_WITH_LONG_RANDOM_STRING
OWNER_NAME=Vaishnavi
# Digits only, with country code
WHATSAPP_NUMBER=6598533395
# Optional: numeric Discord user ID (not the username)
DISCORD_USER_ID=
# Optional: standing Google Meet link
MEET_URL=
# Optional: Google Calendar appointment page, shown as "Book a time"
BOOKING_URL=https://calendar.app.google/yNj5qs4AuKKmZwZQ7
